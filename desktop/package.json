{
  "name": "jio-desktop",
  "version": "0.10.0",
  "private": true,
  "description": "jio, packaged as a desktop app with an offline local model.",
  "author": "WHCreativeDesign",
  "main": "src/main.js",
  "scripts": {
    "copy-web": "node scripts/copy-web.js",
    "brand-assets": "node scripts/gen-brand-assets.js",
    "start": "npm run copy-web && electron .",
    "dist": "npm run copy-web && npm run brand-assets && electron-builder --publish never",
    "release": "npm run copy-web && npm run brand-assets && electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "org.usecloak.jio",
    "productName": "jio",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "asar": true,
    "files": [
      "src/**/*",
      "web/**/*",
      "!web/**/.git*"
    ],
    "extraResources": [
      { "from": "resources/llama", "to": "llama", "filter": ["**/*"] }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "title": "jio ${version}",
      "backgroundColor": "#1f1e1d",
      "window": { "width": 540, "height": 380 },
      "contents": [
        { "x": 150, "y": 200, "type": "file" },
        { "x": 390, "y": 200, "type": "link", "path": "/Applications" }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "include": "nsis/installer.nsh"
    },
    "publish": [
      { "provider": "github", "owner": "WHCreativeDesign", "repo": "Jio", "releaseType": "release" }
    ]
  }
}
